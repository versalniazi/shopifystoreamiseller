<section class="industries-grid page-width" id="industries">
  <div class="section-heading">
    {% if section.settings.eyebrow != blank %}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </div>
  <div class="industries-grid__grid">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link | default: '/pages/industries' }}" class="card industry-card" {{ block.shopify_attributes }}>
        <div class="industry-card__icon">{% render 'icon', name: block.settings.icon, size: 24 %}</div>
        <span>{{ block.settings.title }}</span>
      </a>
    {% endfor %}
  </div>
  {% if section.settings.show_cta %}
    <div class="section-cta">
      <a href="/pages/industries" class="button button--outline">View All Industries We Serve</a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Industries grid",
  "tag": "section",
  "class": "section-industries",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Industries" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Resumes Written for Your Industry" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "We tailor language, keywords, and formatting to what recruiters expect in your field." },
    { "type": "checkbox", "id": "show_cta", "label": "Show 'View all' button", "default": true }
  ],
  "blocks": [
    {
      "type": "industry",
      "name": "Industry",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "code", "options": [
          { "value": "code", "label": "IT" }, { "value": "wrench", "label": "Engineering/Construction" }, { "value": "building", "label": "Finance/Government" },
          { "value": "stethoscope", "label": "Healthcare" }, { "value": "megaphone", "label": "Marketing" }, { "value": "trending-up", "label": "Sales" },
          { "value": "graduation-cap", "label": "Education/Graduates" }, { "value": "scale", "label": "Legal" }, { "value": "utensils", "label": "Hospitality" },
          { "value": "shopping-bag", "label": "Retail" }, { "value": "globe", "label": "Remote Jobs" }, { "value": "crown", "label": "Executives" }
        ]},
        { "type": "text", "id": "title", "label": "Title", "default": "IT & Technology" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "industry", "settings": { "icon": "code", "title": "IT & Technology" } },
      { "type": "industry", "settings": { "icon": "wrench", "title": "Engineering" } },
      { "type": "industry", "settings": { "icon": "building", "title": "Finance" } },
      { "type": "industry", "settings": { "icon": "stethoscope", "title": "Healthcare" } },
      { "type": "industry", "settings": { "icon": "megaphone", "title": "Marketing" } },
      { "type": "industry", "settings": { "icon": "trending-up", "title": "Sales" } },
      { "type": "industry", "settings": { "icon": "graduation-cap", "title": "Education" } },
      { "type": "industry", "settings": { "icon": "building", "title": "Government" } },
      { "type": "industry", "settings": { "icon": "wrench", "title": "Construction" } },
      { "type": "industry", "settings": { "icon": "scale", "title": "Legal" } },
      { "type": "industry", "settings": { "icon": "utensils", "title": "Hospitality" } },
      { "type": "industry", "settings": { "icon": "shopping-bag", "title": "Retail" } },
      { "type": "industry", "settings": { "icon": "globe", "title": "Remote Jobs" } },
      { "type": "industry", "settings": { "icon": "crown", "title": "Executives" } },
      { "type": "industry", "settings": { "icon": "graduation-cap", "title": "Graduates" } }
    ]
  },
  "presets": [{ "name": "Industries grid" }]
}
{% endschema %}
