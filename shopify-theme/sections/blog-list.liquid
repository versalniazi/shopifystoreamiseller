<section class="blog-list page-width" id="blog">
  <div class="section-heading">
    {% if section.settings.eyebrow != blank %}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </div>
  <div class="blog-list__grid">
    {% assign blog = blogs[section.settings.blog] %}
    {% if blog %}
      {% for article in blog.articles limit: section.settings.article_limit %}
        <a href="{{ article.url }}" class="card blog-card">
          <div class="blog-card__media">
            {% if article.image %}
              <img src="{{ article.image | image_url: width: 500 }}" alt="{{ article.image.alt | default: article.title }}" width="{{ article.image.width }}" height="{{ article.image.height }}" loading="lazy">
            {% else %}
              <div class="blog-card__placeholder">{% render 'icon', name: 'file-text', size: 32 %}</div>
            {% endif %}
          </div>
          <span class="blog-card__tag">{% if article.tags.size > 0 %}{{ article.tags.first }}{% else %}Career Advice{% endif %}</span>
          <h3>{{ article.title }}</h3>
          <p>{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..3) %}
        <div class="card blog-card">
          <div class="blog-card__media"><div class="blog-card__placeholder">{% render 'icon', name: 'file-text', size: 32 %}</div></div>
          <span class="blog-card__tag">Career Advice</span>
          <h3>Article title placeholder</h3>
          <p>Create a blog named "Career Advice" and publish articles to populate this section automatically.</p>
        </div>
      {% endfor %}
    {% endif %}
  </div>
  {% if section.settings.show_cta %}
    <div class="section-cta">
      <a href="/blogs/{{ section.settings.blog | default: 'career-advice' }}" class="button button--outline">{{ section.settings.cta_text | default: 'Read More Articles' }}</a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Blog list",
  "tag": "section",
  "class": "section-blog-list",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From the Blog" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Latest Career Advice" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Practical, specific advice on resumes, ATS, LinkedIn, and interviews." },
    { "type": "text", "id": "blog", "label": "Blog handle", "default": "career-advice" },
    { "type": "range", "id": "article_limit", "label": "Articles to show", "min": 3, "max": 6, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_cta", "label": "Show 'Read more' button", "default": true },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Read More Articles" }
  ],
  "presets": [{ "name": "Blog list" }]
}
{% endschema %}
