<section class="stats page-width">
  <div class="stats__grid">
    {% for block in section.blocks %}
      <div class="stats__item" {{ block.shopify_attributes }}>
        <span class="stats__number">{{ block.settings.number }}</span>
        <span class="stats__label">{{ block.settings.label }}</span>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Stats",
  "tag": "section",
  "class": "section-stats",
  "settings": [],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "3-5" },
        { "type": "text", "id": "label", "label": "Label", "default": "Business Days Average Delivery" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "stat", "settings": { "number": "20+", "label": "Industries Served" } },
      { "type": "stat", "settings": { "number": "3-5", "label": "Business Days Average Delivery" } },
      { "type": "stat", "settings": { "number": "100%", "label": "ATS-Optimized Formatting" } },
      { "type": "stat", "settings": { "number": "Worldwide", "label": "Clients Served Remotely" } }
    ]
  },
  "presets": [{ "name": "Stats" }]
}
{% endschema %}
