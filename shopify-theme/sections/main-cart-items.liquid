<section class="main-cart page-width">
  <h1>{{ 'cart.title' | t }}</h1>
  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" class="cart-form">
      <table class="cart-table">
        <thead>
          <tr><th>Product</th><th>{{ 'cart.quantity' | t }}</th><th>{{ 'cart.subtotal' | t }}</th><th></th></tr>
        </thead>
        <tbody>
          {% for item in cart.items %}
            <tr>
              <td>
                <a href="{{ item.url }}">{{ item.product.title }}</a>
              </td>
              <td><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity"></td>
              <td>{{ item.final_line_price | money }}</td>
              <td><a href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a></td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      <div class="cart-form__footer">
        <p class="cart-form__subtotal">{{ 'cart.subtotal' | t }}: {{ cart.total_price | money }}</p>
        <button type="submit" name="update" class="button button--outline">Update Cart</button>
        <button type="submit" name="checkout" class="button button--primary">{{ 'cart.checkout' | t }}</button>
      </div>
    </form>
  {% else %}
    <p>{{ 'cart.empty' | t }}</p>
    <a href="/collections/packages" class="button button--primary">View Packages</a>
  {% endif %}
</section>

{% schema %}
{
  "name": "Cart items",
  "tag": "section",
  "class": "section-main-cart",
  "settings": []
}
{% endschema %}
