<section class="how-it-works page-width" id="how-it-works">
  <div class="section-heading">
    {% if section.settings.eyebrow != blank %}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </div>
  <div class="how-it-works__timeline">
    {% for block in section.blocks %}
      <div class="how-it-works__step" {{ block.shopify_attributes }}>
        <span class="how-it-works__number">{{ forloop.index }}</span>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </div>
    {% endfor %}
  </div>
  {% if section.settings.cta_text != blank %}
    <div class="section-cta">
      <a href="{{ section.settings.cta_link }}" class="button button--primary">{{ section.settings.cta_text }}</a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "How it works",
  "tag": "section",
  "class": "section-how-it-works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Process" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How It Works" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "A simple, guided process from purchase to final delivery." },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Start Your Order" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Choose Your Package" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Select the package that matches where you are in your career." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "step", "settings": { "title": "Choose Your Package", "text": "Select the package that matches your career stage and goals — from a single resume to a full career transformation." } },
      { "type": "step", "settings": { "title": "Share Your Background", "text": "After checkout, send your current resume, job target, and LinkedIn link so your writer can start with full context." } },
      { "type": "step", "settings": { "title": "We Write & Optimize", "text": "A dedicated writer drafts your resume, cover letter, or LinkedIn profile with ATS keyword optimization built in." } },
      { "type": "step", "settings": { "title": "Review & Revise", "text": "You review the draft and request revisions within your package's included rounds until it's right." } },
      { "type": "step", "settings": { "title": "Receive Final Files", "text": "Get your polished, editable Word and PDF files, ready to send to your next employer." } }
    ]
  },
  "presets": [{ "name": "How it works" }]
}
{% endschema %}
