<article class="main-article page-width rich-text--narrow">
  {% if article.tags.size > 0 %}<span class="eyebrow">{{ article.tags.first }}</span>{% endif %}
  <h1>{{ article.title }}</h1>
  <p class="main-article__meta">{{ 'blog.written_by' | t }} {{ article.author }} &middot; {{ article.published_at | date: '%B %d, %Y' }}</p>
  {% if article.image %}
    <img class="main-article__image" src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.image.alt | default: article.title }}" width="{{ article.image.width }}" height="{{ article.image.height }}" loading="eager">
  {% endif %}
  <div class="rich-text__content">{{ article.content }}</div>

  <div class="main-article__cta card">
    <h3>Ready for a resume that matches this advice?</h3>
    <p>Get a professionally written, ATS-optimized resume from Hire Nestt.</p>
    <a href="/collections/packages" class="button button--primary">View Packages</a>
  </div>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ article.title | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%d' | json }},
    "author": { "@type": "Person", "name": {{ article.author | json }} },
    "publisher": { "@type": "Organization", "name": {{ shop.name | json }} }
  }
  </script>
</article>

{% schema %}
{
  "name": "Article",
  "tag": "section",
  "class": "section-main-article",
  "settings": []
}
{% endschema %}
