<section class="rich-text page-width {{ section.settings.width }}">
  {% if section.settings.eyebrow != blank %}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
  {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
  <div class="rich-text__content">{{ section.settings.content }}</div>
  {% if section.settings.cta_text != blank %}
    <a href="{{ section.settings.cta_link }}" class="button button--primary">{{ section.settings.cta_text }}</a>
  {% endif %}
</section>

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "class": "section-rich-text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Add your content here.</p>" },
    { "type": "select", "id": "width", "label": "Content width", "default": "rich-text--narrow", "options": [
      { "value": "rich-text--narrow", "label": "Narrow" }, { "value": "rich-text--wide", "label": "Wide" }
    ]},
    { "type": "text", "id": "cta_text", "label": "Button text" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
