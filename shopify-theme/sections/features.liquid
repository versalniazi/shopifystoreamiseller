<section class="features page-width" id="why-choose-us">
  <div class="section-heading">
    {% if section.settings.eyebrow != blank %}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </div>
  <div class="features__grid">
    {% for block in section.blocks %}
      <div class="card feature-card" {{ block.shopify_attributes }}>
        <div class="feature-card__icon">{% render 'icon', name: block.settings.icon, size: 24 %}</div>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Why choose us",
  "tag": "section",
  "class": "section-features",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why Choose Us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for Professionals Who Expect More"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Every resume is written by hand, optimized for applicant tracking systems, and reviewed before delivery."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "target",
          "options": [
            {
              "value": "target",
              "label": "Target"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "clock",
              "label": "Clock"
            },
            {
              "value": "award",
              "label": "Award"
            },
            {
              "value": "users",
              "label": "Users"
            },
            {
              "value": "check-circle",
              "label": "Check"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "ATS-Optimized"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Every document is formatted and keyword-matched to pass applicant tracking systems."
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "feature",
        "settings": {
          "icon": "target",
          "title": "ATS-Optimized by Default",
          "text": "Every resume is formatted and keyword-aligned to pass applicant tracking systems before it ever reaches a recruiter."
        }
      },
      {
        "type": "feature",
        "settings": {
          "icon": "shield",
          "title": "100% Confidential",
          "text": "Your career details and documents are never shared, sold, or used without your permission."
        }
      },
      {
        "type": "feature",
        "settings": {
          "icon": "clock",
          "title": "Clear Turnaround Times",
          "text": "Every package lists an exact delivery window in business days — no vague promises."
        }
      },
      {
        "type": "feature",
        "settings": {
          "icon": "award",
          "title": "Achievement-Based Writing",
          "text": "We frame your experience around measurable results, not just job duties."
        }
      },
      {
        "type": "feature",
        "settings": {
          "icon": "users",
          "title": "Built for Every Career Stage",
          "text": "From graduate to executive, packages are structured around where you actually are."
        }
      },
      {
        "type": "feature",
        "settings": {
          "icon": "check-circle",
          "title": "Editable, Yours to Keep",
          "text": "Receive fully editable Word files plus a polished PDF — no lock-in, no subscriptions."
        }
      }
    ]
  }
}
{% endschema %}
