<section class="contact-section page-width">
  <div class="contact-section__grid">
    <div class="contact-section__form-wrap card">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
      {% form 'contact', class: 'contact-form' %}
        {% if form.posted_successfully? %}
          <p class="contact-form__success">{% render 'icon', name: 'check-circle', size: 18 %} Thanks — we'll reply within one business day.</p>
        {% endif %}
        <div class="contact-form__row">
          <label for="ContactName">Name</label>
          <input type="text" id="ContactName" name="contact[name]" required>
        </div>
        <div class="contact-form__row">
          <label for="ContactEmail">Email</label>
          <input type="email" id="ContactEmail" name="contact[email]" value="{% if customer %}{{ customer.email }}{% endif %}" required>
        </div>
        <div class="contact-form__row">
          <label for="ContactSubject">Subject</label>
          <select id="ContactSubject" name="contact[subject]">
            <option>General Question</option>
            <option>Order / Delivery Question</option>
            <option>Revision Request</option>
            <option>Refund Request</option>
            <option>Partnership / Other</option>
          </select>
        </div>
        <div class="contact-form__row">
          <label for="ContactMessage">Message</label>
          <textarea id="ContactMessage" name="contact[body]" rows="5" required></textarea>
        </div>
        <button type="submit" class="button button--primary">{{ section.settings.cta_text | default: 'Send Message' }}</button>
      {% endform %}
    </div>

    <div class="contact-section__details">
      <div class="card contact-detail">
        <h3>{% render 'icon', name: 'mail', size: 18 %} Email</h3>
        <p><a href="mailto:{{ section.settings.email | default: 'hirenest56@gmail.com' }}">{{ section.settings.email | default: 'hirenest56@gmail.com' }}</a></p>
      </div>
      <div class="card contact-detail">
        <h3>{% render 'icon', name: 'clock', size: 18 %} Business Hours</h3>
        <p>{{ section.settings.hours }}</p>
      </div>
      <div class="card contact-detail">
        <h3>{% render 'icon', name: 'map-pin', size: 18 %} Location</h3>
        <p>{{ section.settings.location }}</p>
        <div class="contact-detail__map-placeholder" aria-hidden="true">{% render 'icon', name: 'map-pin', size: 32 %}<span>Map placeholder — embed Google Maps once a business address is added</span></div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "section-contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in Touch" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Questions about a package, an existing order, or a custom request? Send us a message." },
    { "type": "text", "id": "email", "label": "Contact email", "default": "hirenest56@gmail.com" },
    { "type": "text", "id": "hours", "label": "Business hours", "default": "Monday - Friday, 9:00 AM - 6:00 PM (client time zones accommodated worldwide)" },
    { "type": "text", "id": "location", "label": "Location text", "default": "Remote-first — serving clients worldwide" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Send Message" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
