<section class="hero page-width">
  <div class="hero__content">
    {% if section.settings.eyebrow != blank %}
      <span class="eyebrow">{% render 'icon', name: 'shield', size: 14 %} {{ section.settings.eyebrow }}</span>
    {% endif %}
    <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    <p class="hero__subheading">{{ section.settings.subheading }}</p>
    <div class="hero__actions">
      <a href="{{ section.settings.primary_link }}" class="button button--primary button--large">{{ section.settings.primary_text }}</a>
      <a href="{{ section.settings.secondary_link }}" class="button button--outline button--large">{{ section.settings.secondary_text }}</a>
    </div>
    <div class="hero__proof">
      <div class="hero__stars">
        {% for i in (1..5) %}{% render 'icon', name: 'star', size: 16 %}{% endfor %}
      </div>
      <span>{{ section.settings.proof_text }}</span>
    </div>
  </div>
  <div class="hero__media">
    {% if section.settings.image %}
      <img src="{{ section.settings.image | image_url: width: 1200 }}"
           srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
           sizes="(min-width: 990px) 560px, 90vw"
           alt="{{ section.settings.image.alt | default: 'Professionally written resume example' }}"
           width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
           loading="eager" fetchpriority="high">
    {% else %}
      <div class="hero__media-placeholder" role="img" aria-label="Resume before and after example">
        {% render 'icon', name: 'file-text', size: 64 %}
      </div>
    {% endif %}
    <div class="hero__badge">{% render 'icon', name: 'check-circle', size: 18 %} ATS-Optimized</div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Trusted Career Services" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Resumes That Get Read. Careers That Move Forward." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Hire Nestt writes ATS-optimized resumes, cover letters, and LinkedIn profiles for professionals who refuse to be overlooked — reviewed, refined, and delivered in as little as 2 business days." },
    { "type": "text", "id": "primary_text", "label": "Primary button text", "default": "View Packages" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_text", "label": "Secondary button text", "default": "How It Works" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "text", "id": "proof_text", "label": "Social proof text", "default": "Rated by professionals across 20+ industries worldwide" },
    { "type": "image_picker", "id": "image", "label": "Hero image" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
