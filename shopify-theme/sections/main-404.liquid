<section class="main-404 page-width">
  <div class="main-404__content">
    {% render 'icon', name: 'search', size: 48 %}
    <h1>Page Not Found</h1>
    <p>The page you're looking for doesn't exist. Let's get you back on track.</p>
    <div class="hero__actions">
      <a href="{{ routes.root_url }}" class="button button--primary">Back to Home</a>
      <a href="/collections/packages" class="button button--outline">View Packages</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "tag": "section",
  "class": "section-main-404",
  "settings": []
}
{% endschema %}
