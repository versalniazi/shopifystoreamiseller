<section class="main-collection page-width">
  <div class="section-heading">
    <h1>{{ collection.title }}</h1>
    {% if collection.description != blank %}<p>{{ collection.description }}</p>{% endif %}
  </div>
  <div class="pricing-cards__grid">
    {% for product in collection.products %}
      <div class="card pricing-card {% if product.metafields.custom.featured %}pricing-card--featured{% endif %}">
        {% if product.metafields.custom.badge %}<span class="pricing-card__badge">{{ product.metafields.custom.badge }}</span>{% endif %}
        <h3 class="pricing-card__title">{{ product.title }}</h3>
        <p class="pricing-card__price"><span>{{ product.price | money_without_trailing_zeros }}</span></p>
        <p class="pricing-card__excerpt">{{ product.description | strip_html | truncatewords: 20 }}</p>
        {% if product.metafields.custom.delivery_days %}
          <p class="pricing-card__delivery">{% render 'icon', name: 'clock', size: 14 %} Delivery: {{ product.metafields.custom.delivery_days }}</p>
        {% endif %}
        <a href="{{ product.url }}" class="button button--outline pricing-card__cta">View Package</a>
      </div>
    {% else %}
      <p>No packages found. Add products to this collection from Shopify Admin → Products, and assign them to the "Packages" collection.</p>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Collection packages",
  "tag": "section",
  "class": "section-main-collection",
  "settings": []
}
{% endschema %}
